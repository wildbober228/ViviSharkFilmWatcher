{
  "manifest_version": 3,
  "name": "FilmWatcher Remote",
  "version": "1.0.0",
  "description": "Lets your FilmWatcher partner pause and skip the video in the tab you're sharing.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wildbober228.github.io/ViviSharkFilmWatcher/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://wildbober228.github.io/ViviSharkFilmWatcher/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["player.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
